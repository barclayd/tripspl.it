# Copy to .dev.vars for local authentication, and configure production secrets with cf.
# No login bypass is provided. Health, arithmetic, and runtime tests work without live Apple credentials.
APPLE_AUDIENCE=it.tripspl.TripSplit
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# APNs key for nudges. Leave empty to record nudges without pushing; APNS_PRIVATE_KEY is only needed for a separate key.
APNS_KEY_ID=
APNS_PRIVATE_KEY=
# Base64 encoding of 32 cryptographically random bytes; never rotate without re-encrypting Apple grants.
SESSION_ENCRYPTION_KEY=
# Only set after the actual universal-link host and application identifier are provisioned.
INVITE_ORIGIN=
APPLE_APP_ID=
