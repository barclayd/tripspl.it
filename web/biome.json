{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true, "includes": ["**", "!dist", "!.astro", "!node_modules"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "css": { "formatter": { "quoteStyle": "single" } },
  "html": { "experimentalFullSupportEnabled": true, "formatter": { "enabled": false } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
