---
import Plane from './Plane.astro';

// Each row is printed in its final state so the board reads without JavaScript.
// The flap script blanks the cells and spins them in when the board scrolls into view.
const rows = [
  { flag: '🇵🇹', dest: 'LISBON +2', date: '28 OCT', status: 'ON TRIP', color: '#5BE49B', said: 'Lisbon plus 2, 28 October, on trip' },
  { flag: '🇨🇭', dest: 'ZERMATT', date: '19 DEC', status: 'IN 49D', color: '#F7C948', said: 'Zermatt, 19 December, in 49 days' },
  { flag: '🇯🇵', dest: 'TOKYO +2', date: '27 MAR', status: 'IN 147D', color: '#F7C948', said: 'Tokyo plus 2, 27 March, in 147 days' },
  {
    flag: '🇮🇸',
    dest: 'REYKJAVIK',
    date: '14 MAY',
    status: 'PLANNED',
    color: 'rgba(243,239,230,0.55)',
    said: 'Reykjavik, 14 May, planned',
  },
];

const cells = (text: string, len: number) => text.toUpperCase().padEnd(len, ' ').slice(0, len).split('');
const glyph = (c: string) => (c === ' ' ? ' ' : c);
---

<section class="dep" aria-labelledby="dep-title">
  <div class="sticky-stage dep-stage">
    <h2 class="dep-h2" id="dep-title">Every trip is on the board.</h2>
    <div class="board" data-board>
      <div class="board-head" aria-hidden="true">
        <div class="board-name"><Plane size={18} class="r45" />DEPARTURES</div>
        <div class="board-clock">09:41</div>
      </div>
      <div class="board-row board-cols" aria-hidden="true">
        <span></span><span>DESTINATION</span><span>DATE</span><span>STATUS</span>
      </div>
      <ul class="board-list">
        {
          rows.map((r, i) => (
            <li class="board-row">
              <span class="sr-only">{r.said}</span>
              <span class="board-flag" aria-hidden="true">
                {r.flag}
              </span>
              {[
                { text: r.dest, len: 10, delay: 150 + i * 240, color: '#F3EFE6' },
                { text: r.date, len: 6, delay: 260 + i * 240, color: '#F3EFE6' },
                { text: r.status, len: 7, delay: 380 + i * 240, color: r.color },
              ].map((f) => (
                <span class="flap" data-flap={f.text} data-len={f.len} data-delay={f.delay} style={`color:${f.color}`} aria-hidden="true">
                  {cells(f.text, f.len).map((c) => (
                    <span class="cell">
                      <span class="half top">
                        <span class="glyph">{glyph(c)}</span>
                      </span>
                      <span class="half bot">
                        <span class="glyph">{glyph(c)}</span>
                      </span>
                      <span class="mid" />
                    </span>
                  ))}
                </span>
              ))}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .dep {
    position: relative;
    height: 170vh;
  }
  .dep-stage {
    padding: 64px 24px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 36px;
  }
  .dep-h2 {
    font-size: clamp(36px, 5.5vw, 72px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
    text-align: center;
  }
  .board {
    --fw: 17px;
    --fh: 28px;
    --fs: 17px;
    width: min(100%, 640px);
    background: #121316;
    border-radius: 28px;
    padding: 22px 20px 12px;
    color: #f3efe6;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.05),
      0 40px 60px -36px rgba(0, 0, 0, 0.6);
  }
  .board-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px 14px;
  }
  .board-name {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #f7c948;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.18em;
  }
  .board-name :global(.r45) {
    transform: rotate(45deg);
  }
  .board-clock {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
    color: #f7c948;
  }
  .board-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .board-row {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto auto;
    gap: 10px;
    align-items: center;
    padding: 10px 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .board-cols {
    padding: 0 4px 8px;
    border-top: 0;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: rgba(243, 239, 230, 0.45);
  }
  .board-flag {
    font-size: 22px;
    line-height: 1;
  }

  /* Split-flap cells */
  .flap {
    display: inline-flex;
    gap: 2px;
    max-width: 100%;
    overflow: hidden;
  }
  .flap :global(.cell) {
    position: relative;
    display: block;
    width: var(--fw);
    height: var(--fh);
    perspective: calc(var(--fh) * 5);
    font-size: var(--fs);
    font-weight: 700;
    font-family: var(--mono);
    flex-shrink: 0;
  }
  .flap :global(.half) {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    overflow: hidden;
    backface-visibility: hidden;
  }
  .flap :global(.top) {
    top: 0;
    background: #27282c;
    border-radius: 4px 4px 0 0;
  }
  .flap :global(.bot) {
    top: 50%;
    background: #1f2023;
    border-radius: 0 0 4px 4px;
  }
  .flap :global(.glyph) {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--fh);
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .flap :global(.bot .glyph) {
    top: calc(var(--fh) / -2);
  }
  .flap :global(.leaf) {
    z-index: 2;
  }
  .flap :global(.top.leaf) {
    transform-origin: 50% 100%;
    animation: lpFlapTop 32ms cubic-bezier(0.55, 0, 1, 0.45) both;
  }
  .flap :global(.bot.leaf) {
    transform-origin: 50% 0%;
    animation: lpFlapBot 32ms cubic-bezier(0, 0.55, 0.45, 1) 32ms both;
  }
  .flap :global(.mid) {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    margin-top: -0.5px;
    background: rgba(0, 0, 0, 0.7);
    z-index: 3;
  }

  @media (prefers-color-scheme: dark) {
    .board {
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.09),
        0 40px 60px -36px rgba(0, 0, 0, 0.9);
    }
  }

  @media (max-width: 640px) {
    .board {
      --fw: 10px;
      --fh: 17px;
      --fs: 10.5px;
      padding: 18px 12px 10px;
    }
    .board-row {
      grid-template-columns: 22px minmax(0, 1fr) auto auto;
      gap: 6px;
    }
  }
</style>
