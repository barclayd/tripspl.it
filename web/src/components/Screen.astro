---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// An app screenshot that follows the system theme: AVIF with a WebP fallback,
// 1x and 2x, and a dark-mode source when one exists.
interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  /** Display width in CSS pixels; 1x and 2x files are generated from it. */
  width: number;
  alt: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { light, dark, width, alt, loading = 'lazy', class: cls } = Astro.props;

async function srcset(src: ImageMetadata, format: 'avif' | 'webp') {
  const w2 = Math.min(src.width, width * 2);
  const [one, two] = await Promise.all([
    getImage({ src, width, format, quality: format === 'avif' ? 60 : 78 }),
    getImage({ src, width: w2, format, quality: format === 'avif' ? 60 : 78 }),
  ]);
  return { set: `${one.src} 1x, ${two.src} 2x`, src: one.src };
}

const [lightAvif, lightWebp] = await Promise.all([srcset(light, 'avif'), srcset(light, 'webp')]);
const darkSets = dark ? await Promise.all([srcset(dark, 'avif'), srcset(dark, 'webp')]) : null;
const height = Math.round((width * light.height) / light.width);
---

<picture class:list={['screen', cls]}>
  {
    darkSets && (
      <>
        <source media="(prefers-color-scheme: dark)" type="image/avif" srcset={darkSets[0].set} />
        <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={darkSets[1].set} />
      </>
    )
  }
  <source type="image/avif" srcset={lightAvif.set} />
  <img src={lightWebp.src} srcset={lightWebp.set} width={width} height={height} alt={alt} loading={loading} decoding="async" />
</picture>

<style>
  .screen {
    display: block;
    width: 100%;
    height: 100%;
  }
  .screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
