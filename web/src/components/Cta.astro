---
const tiles = [
  { e: '✈️', left: '14%', top: '8%', s: 112, rad: 34, bg: '#FFF', fs: 58, r: -10, d: 0 },
  { e: '🚆', left: '52%', top: '34%', s: 104, rad: 31, bg: '#FFF4C9', fs: 54, r: 8, d: 0.7 },
  { e: '🧾', left: '8%', top: '62%', s: 72, rad: 22, bg: '#FFFDF6', fs: 37, r: -4, d: 1.4 },
  { e: '💷', left: '78%', top: '6%', s: 64, rad: 19, bg: 'oklch(0.94 0.045 155)', fs: 33, r: 12, d: 2.1 },
  { e: '🌍', left: '34%', top: '74%', s: 58, rad: 17, bg: 'oklch(0.94 0.045 235)', fs: 30, r: -14, d: 2.8 },
];
---

<section class="cta" aria-labelledby="cta-title">
  <div class="panel">
    <div class="left">
      <h2 class="cta-h2" id="cta-title">The ultimate companion for the cost conscious traveller.</h2>
      <div class="store">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9s-2.1-.9-3.4-.9c-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.4.8 2.2-1.3 3.1-2.5c1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.7-4.1zM13.9 4.9c.7-.9 1.2-2 1.1-3.2-1 0-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.1 1.1.1 2.3-.6 3-1.5z"
          ></path>
        </svg>
        <span class="store-text">
          <span class="store-small">Landing in the</span>
          <span class="store-big">App Store soon</span>
        </span>
      </div>
    </div>
    <div class="right" aria-hidden="true">
      {
        tiles.map((t) => (
          <span
            class="tile pastel"
            style={`left:${t.left};top:${t.top};width:${t.s}px;height:${t.s}px;border-radius:${t.rad}px;background:${t.bg};font-size:${t.fs}px;--r:${t.r}deg;animation-delay:${t.d}s`}
          >
            {t.e}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 40px 24px 120px;
    display: flex;
    justify-content: center;
  }
  .panel {
    position: relative;
    overflow: hidden;
    width: min(100%, 1100px);
    border-radius: 40px;
    background: oklch(0.6 0.23 4);
    color: #fff;
    padding: clamp(36px, 6vw, 72px) clamp(28px, 6vw, 72px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    align-items: center;
    gap: 40px;
    box-shadow: 0 30px 60px -40px oklch(0.6 0.23 4);
  }
  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 90% at 100% 0%, oklch(0.7 0.2 10) 0%, rgba(0, 0, 0, 0) 60%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 2px, transparent 2px 14px);
    pointer-events: none;
  }
  .left {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .cta-h2 {
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .store {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 13px 22px 13px 18px;
    border-radius: 18px;
    background: #fff;
    color: #16120f;
    box-shadow: 0 5px 0 oklch(0.47 0.2 4);
  }
  .store-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .store-small {
    font-size: 12px;
    font-weight: 700;
    color: #6f6862;
  }
  .store-big {
    font-size: 19px;
    font-weight: 800;
  }
  .right {
    position: relative;
    height: 240px;
  }
  .tile {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 18px 30px -16px rgba(60, 0, 20, 0.55);
    transform: rotate(var(--r));
    animation: lpBob 4.2s ease-in-out infinite;
  }

  @media (prefers-color-scheme: dark) {
    .panel {
      background: oklch(0.22 0.08 4);
      box-shadow:
        inset 0 0 0 1px oklch(0.45 0.16 4 / 0.5),
        0 40px 80px -50px oklch(0.6 0.23 4);
    }
    .cta-h2 {
      color: #fff;
    }
    .store {
      box-shadow: 0 5px 0 oklch(0.42 0.17 4);
    }
  }
</style>
