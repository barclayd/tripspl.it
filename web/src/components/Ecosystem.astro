---
import dayDark from '../assets/screens/iphone-day-dark.png';
import dayLight from '../assets/screens/iphone-day-light.png';
import tripDark from '../assets/screens/iphone-trip-dark.png';
import tripLight from '../assets/screens/iphone-trip-light.png';
import tripsDark from '../assets/screens/iphone-trips-dark.png';
import tripsLight from '../assets/screens/iphone-trips-light.png';
import watchTrips from '../assets/screens/watch-trips.png';
import Screen from './Screen.astro';

const features = [
  'Apple Watch app',
  'Complications',
  'Smart Stack',
  'Widgets',
  'Live Activities',
  'iPhone Duo',
  'iCloud sync',
  'Apple Maps',
  'Siri',
];
---

<section class="eco" aria-labelledby="eco-title">
  <h2 class="display eco-h2" id="eco-title">At home on<br />every Apple device.</h2>
  <div class="devices">
    <figure class="device">
      <div class="iphone frame">
        <div class="iphone-screen">
          <Screen light={dayLight} dark={dayDark} width={212} alt="TripSplit on iPhone: a day of the trip with its spending" />
        </div>
      </div>
      <figcaption>iPhone</figcaption>
    </figure>
    <figure class="device">
      <div class="duo frame">
        <div class="duo-screen">
          <div class="duo-pane">
            <Screen light={tripsLight} dark={tripsDark} width={190} class="duo-shot" alt="Left screen: the Trips list" />
          </div>
          <div class="duo-pane">
            <Screen
              light={tripLight}
              dark={tripDark}
              width={330}
              class="duo-shot"
              alt="Right screen: the selected trip with its budget and spending"
            />
          </div>
        </div>
      </div>
      <figcaption>iPhone Duo, open</figcaption>
    </figure>
    <figure class="device">
      <div class="watch frame">
        <div class="crown" aria-hidden="true"></div>
        <div class="watch-screen">
          <Screen light={watchTrips} width={174} alt="TripSplit on Apple Watch: the Trips list" />
        </div>
      </div>
      <figcaption>Apple Watch</figcaption>
    </figure>
  </div>
  <ul class="features">
    {features.map((f) => <li class="feature-chip sf">{f}</li>)}
  </ul>
</section>

<style>
  .eco {
    padding: 140px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    background: linear-gradient(var(--bg), var(--acSoft) 60%, var(--bg));
  }
  .eco-h2 {
    text-align: center;
  }
  .devices {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-end;
    gap: 28px;
    max-width: 1200px;
  }
  .device {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  figcaption {
    font-size: 16px;
    font-weight: 800;
  }
  .frame {
    background: #0e0f12;
  }
  .iphone {
    width: 230px;
    height: 470px;
    border-radius: 44px;
    padding: 9px;
  }
  .iphone-screen {
    width: 100%;
    height: 100%;
    border-radius: 36px;
    overflow: hidden;
    background: var(--bg);
  }
  .duo {
    width: min(86vw, 520px);
    aspect-ratio: 951 / 669;
    border-radius: 30px;
    padding: 9px;
  }
  .duo-screen {
    width: 100%;
    height: 100%;
    border-radius: 22px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 36% 1fr;
    background: var(--bg);
  }
  .duo-pane {
    min-width: 0;
    overflow: hidden;
  }
  .duo-pane + .duo-pane {
    border-left: 1px solid var(--hairline);
  }
  /* Each pane shows its screenshot from just below the status bar, as one continuous display. */
  .duo-pane :global(.duo-shot) {
    height: auto;
  }
  .duo-pane :global(.duo-shot img) {
    height: auto;
    margin-top: -14.5%;
  }
  .watch {
    position: relative;
    width: 190px;
    height: 226px;
    border-radius: 52px;
    background: linear-gradient(150deg, #4a4a4f, #151517 55%, #2b2b2e);
    padding: 8px;
  }
  .crown {
    position: absolute;
    right: -5px;
    top: 56px;
    width: 7px;
    height: 36px;
    border-radius: 3px;
    background: #3a3a3e;
  }
  .watch-screen {
    width: 100%;
    height: 100%;
    border-radius: 44px;
    overflow: hidden;
    background: #000;
  }
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 780px;
  }
  .feature-chip {
    padding: 11px 18px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 800;
    box-shadow: 0 10px 24px -18px rgba(22, 18, 15, 0.4);
  }

  @media (prefers-color-scheme: dark) {
    .eco {
      background: linear-gradient(#000, oklch(0.17 0.05 4) 60%, #000);
    }
    .iphone,
    .duo {
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.14),
        0 40px 80px -40px rgba(0, 0, 0, 0.9);
    }
    .watch {
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
    }
  }
</style>
