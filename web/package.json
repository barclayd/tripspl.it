{
  "name": "tripsplit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-output.mjs",
    "preview": "astro preview",
    "check": "biome check . && astro check",
    "format": "biome check --write .",
    "deploy": "bun run build && node scripts/cf-auth.mjs deploy --prebuilt"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "@cloudflare/build-output-utils": "0.9.6",
    "@cloudflare/config": "0.29.0",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "astro": "7.4.4",
    "cf": "1.0.0-beta.26",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  }
}
